<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部渐变背景 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_travel_gradient"
            android:paddingTop="28dp"
            android:paddingBottom="32dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✈️ 创建新行程"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="填写信息，AI为您智能规划最佳路线"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:alpha="0.9"/>
        </LinearLayout>

        <!-- 表单区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_marginTop="-16dp">

            <!-- 表单卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- 目的地 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🗺️ 目的地"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="10dp"/>

                        <AutoCompleteTextView
                            android:id="@+id/actv_destination"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:hint="点击选择城市"
                            android:inputType="text"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:background="@drawable/bg_input_field"
                            android:dropDownVerticalOffset="8dp"
                            android:dropDownWidth="match_parent"
                            android:completionThreshold="0"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"/>
                    </LinearLayout>

                    <!-- 天数和人数 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📅 天数"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginBottom="10dp"/>

                            <EditText
                                android:id="@+id/et_days"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:hint="天数"
                                android:inputType="number"
                                android:paddingLeft="20dp"
                                android:paddingRight="20dp"
                                android:background="@drawable/bg_input_field"
                                android:textSize="16sp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="👥 人数"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginBottom="10dp"/>

                            <EditText
                                android:id="@+id/et_people_count"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:hint="人数"
                                android:inputType="number"
                                android:paddingLeft="20dp"
                                android:paddingRight="20dp"
                                android:background="@drawable/bg_input_field"
                                android:textSize="16sp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 预算 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💰 预算 (¥)"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="10dp"/>

                        <EditText
                            android:id="@+id/et_budget"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:hint="请输入预算金额"
                            android:inputType="numberDecimal"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:background="@drawable/bg_input_field"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"/>
                    </LinearLayout>

                    <!-- 开始日期 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📆 出发日期"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="10dp"/>

                        <EditText
                            android:id="@+id/et_start_date"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:hint="格式: 2026-04-01"
                            android:inputType="date"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:background="@drawable/bg_input_field"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"/>
                    </LinearLayout>

                    <!-- 旅行风格 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯 旅行风格"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="10dp"/>

                        <Spinner
                            android:id="@+id/sp_travel_style"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_spinner"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"/>
                    </LinearLayout>

                    <!-- 出发地 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚀 出发地"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="10dp"/>

                        <AutoCompleteTextView
                            android:id="@+id/actv_origin"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:hint="请输入出发城市"
                            android:inputType="text"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:background="@drawable/bg_input_field"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:completionThreshold="1"/>
                    </LinearLayout>

                    <!-- 禁忌需求 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚫 禁忌需求（选填）"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="10dp"/>

                        <EditText
                            android:id="@+id/et_restrictions"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:hint="如：不逛拥挤景点、不吃辣..."
                            android:inputType="text"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:background="@drawable/bg_input_field"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AI生成按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_generate"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="🤖 AI智能生成行程"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/accent"
                app:cornerRadius="28dp"
                android:layout_marginBottom="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <!-- 提示文字 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 AI将根据您的需求智能规划最佳行程，推荐错峰出行时间"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
