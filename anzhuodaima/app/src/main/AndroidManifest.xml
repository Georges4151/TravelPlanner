<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
      <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".TravelPlannerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TravelPlanner"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.TravelPlanner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.itinerary.ItineraryDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.itinerary.CreateItineraryActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.template.TemplateActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.attraction.AttractionDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.budget.BudgetActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.checklist.ChecklistActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.info.InfoActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.user.UserActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.transport.TransportPlanActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.transport.TransportOptionsActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.transport.TransportDemoActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.restaurant.RestaurantSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.restaurant.RestaurantDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />
        
        <activity
            android:name=".ui.restaurant.CitySelectActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />
        
        <activity
            android:name=".ui.favorite.FavoritesActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.hotel.HotelSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.hotel.HotelDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.attraction.AttractionSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.reminder.ReminderMainActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.reminder.TripReminderActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <activity
            android:name=".ui.reminder.CollaborationActivity"
            android:exported="false"
            android:theme="@style/Theme.TravelPlanner" />

        <receiver
            android:name=".ui.reminder.ReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.travelplanner.REMINDER" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
