<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="智能行程交通规划"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择你的行程"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择行程"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerItinerary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="#F5F5F5"
            android:padding="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设置出发地和目的地"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="出发地"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOrigin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="目的地"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择出行方式（可多选）"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="公共交通"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbTrain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="火车"
                android:padding="8dp"
                android:textSize="15sp"/>

            <CheckBox
                android:id="@+id/cbHighspeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="高铁"
                android:padding="8dp"
                android:textSize="15sp"/>

            <CheckBox
                android:id="@+id/cbFlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="飞机"
                android:padding="8dp"
                android:textSize="15sp"/>

            <CheckBox
                android:id="@+id/cbTransit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="公交"
                android:padding="8dp"
                android:textSize="15sp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="自驾/慢行"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbDrive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="驾车"
                android:padding="8dp"
                android:textSize="15sp"/>

            <CheckBox
                android:id="@+id/cbWalk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="步行"
                android:padding="8dp"
                android:textSize="15sp"/>

            <CheckBox
                android:id="@+id/cbRide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="骑行"
                android:padding="8dp"
                android:textSize="15sp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnViewTransport"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="AI规划路线"
            android:textSize="16sp"
            android:enabled="false"/>

    </LinearLayout>

</ScrollView>
